#!/usr/bin/env bash
# preflight: read-only health report for the theater rig. Run it at the rig with the USB DAC connected, ideally after a fresh boot,
# then paste the report (also saved to ~/theater-preflight-<time>.txt) into the chat. Nothing is played and nothing is changed.
#
#   preflight                     the report
#   preflight --tests             also run the repository's test suite (needs the repo; set SDHT=/path/to/repo if it is not ~/SDHT)
#   preflight capture SOURCE [S]  record S seconds (default 30) of a digital-input source and try to decode it as Dolby Digital
#                                 (the Fire Stick optical-in test). SOURCE is a name from: pactl list short sources
#   preflight playing             run in a second terminal WHILE mpv-object-audio (or mpv-atmos) is playing a film: router state, what the
#                                 stream is classified as, mpv's port names and whether they are linked into CamillaDSP, mpv's live audio
#                                 parameters. Read-only; saved to ~/theater-playing-<time>.txt
#   preflight compare FILE        NOT read-only (it runs both players for 12 s each, muted, and the router may switch the profile for FILE):
#                                 mpv-atmos against mpv-object-audio on the same file, and a diff of the engine lines that matter
#                                 (engine version, speaker layout, room ratios, dialogue normalisation, master gain, channel routing)
USB="${THEATER_USB:-alsa_output.usb-0d8c_USB_Sound_Device-00.analog-surround-71}"
have() { command -v "$1" >/dev/null 2>&1; }
run() { echo "\$ $*"; timeout "${T:-10}" "$@" 2>&1 | head -"${N:-40}"; }
sec() { echo; echo "== $1 =="; }
ok() { echo "OK    $*"; }
warn() { echo "WARN  $*"; }

if [ "$1" = playing ]; then
    REPORT="$HOME/theater-playing-$(date +%Y%m%d-%H%M%S).txt"
    exec > >(tee "$REPORT") 2>&1
    echo "theater preflight, playing $(date -Is)"
    sec "router and profile"
    have eq && { N=30 run eq status; echo "-- classification:"; N=12 run eq source; } || warn "eq not installed"
    sec "mpv ports and links"
    ports=$(pw-link -o 2>/dev/null | grep -E '^ *mpv:output_' | sed 's/^ *//')
    if [ -z "$ports" ]; then
        warn "no mpv output ports: is a film playing, and is it mpv?"
    else
        echo "$ports"
        n=$(echo "$ports" | wc -l); good=$(echo "$ports" | grep -c -E 'output_(FL|FR|RL|RR|FC|LFE|SL|SR)$')
        [ "$good" -eq "$n" ] && ok "all $n mpv ports carry names the router knows (FL FR RL RR FC LFE SL SR)" \
            || warn "$((n-good)) of $n mpv ports have other names (AUX0.. means mpv gave PipeWire no channel map); the router matches FL FR RL RR FC LFE SL SR and will skip the others"
        echo "-- where they go:"
        pw-link -l 2>/dev/null | awk '/^ *mpv:output_/{p=$1; next} /^ *\|->/{ if (p!="") print "  " p "  " $0 } /^[^ |]/{p=""}' | head -20
        cam=$(pw-link -l 2>/dev/null | grep -A1 -E '^ *mpv:output_' | grep -c 'camilladsp-capture')
        usb=$(pw-link -l 2>/dev/null | grep -A1 -E '^ *mpv:output_' | grep -c "$USB")
        echo "links from mpv into CamillaDSP: $cam;  straight into the USB interface: $usb"
        [ "$cam" -gt 0 ] && [ "$usb" -eq 0 ] && ok "mpv goes through CamillaDSP" || { [ "$cam" -eq 0 ] && warn "mpv is NOT linked into CamillaDSP (EQ, delays and trims are not applied)"; }
    fi
    sec "mpv live audio parameters (IPC socket)"
    S="${THEATER_MPV_SOCK:-${XDG_RUNTIME_DIR:-/tmp}/theater-mpv.sock}"
    if [ -S "$S" ] && have socat; then
        for p in current-ao audio-codec-name audio-params audio-out-params audio-delay pause time-pos; do
            echo -n "$p = "; echo "{\"command\":[\"get_property\",\"$p\"]}" | socat - "$S" 2>/dev/null | head -1
        done
    else
        warn "no mpv IPC socket at $S (or socat missing)"
    fi
    sec "graph health"
    have pw-top && { T=8 N=30 run pw-top -b -n 2; }
    echo; echo "report saved to $REPORT"
    exit 0
fi

if [ "$1" = compare ]; then
    F="$2"; [ -f "$F" ] || { echo "usage: preflight compare FILE   (a film file, ideally the Atmos clip)"; exit 1; }
    OUT=$(mktemp -d /tmp/preflight-compare-XXXXXX)
    KEY='orender: loaded|Speaker layout|Room ratio|Dialog normalization|Master gain|Label to speaker|VBAP render|Channel routing|Spread range|Crossover band|AO:'
    for pl in mpv-atmos mpv-object-audio; do
        if have "$pl"; then
            echo "running $pl for 12 s on: $F"
            timeout 40 "$pl" --ao=null --vo=null --length=12 "$F" </dev/null > "$OUT/$pl.log" 2>&1
            grep -E "$KEY" "$OUT/$pl.log" | sed -E 's/^\[[0-9T:.Z-]+ //' | sed -E 's/ \(built [^)]*\)//' > "$OUT/$pl.key"
            echo "-- $pl: $(wc -l < "$OUT/$pl.key") key lines"
        else
            warn "$pl not installed"; : > "$OUT/$pl.key"
        fi
    done
    echo; echo "== lines only in mpv-atmos (<) or only in mpv-object-audio (>) =="
    diff "$OUT/mpv-atmos.key" "$OUT/mpv-object-audio.key" || true
    echo; echo "(full logs: $OUT/*.log). A difference in 'Dialog normalization' or 'Master gain' means the two players play at different levels."
    exit 0
fi

if [ "$1" = capture ]; then
    SRC="$2"; SECS="${3:-30}"
    [ -n "$SRC" ] || { echo "usage: preflight capture SOURCE [seconds]   (see: pactl list short sources)"; exit 1; }
    have pw-record && have ffmpeg && have ffprobe || { echo "needs pw-record, ffmpeg and ffprobe"; exit 1; }
    F=$(mktemp /tmp/spdif-probe-XXXXXX.wav)
    echo "recording $SECS s from $SRC (start Dolby Digital playback on the Fire Stick now) ..."
    timeout -s INT "$SECS" pw-record --target "$SRC" --rate 48000 --format s16 --channels 2 "$F" 2>/dev/null
    echo "-- what ffmpeg sees in the bits (expect ac3 and 6 channels):"
    ffprobe -v error -f spdif -show_entries stream=codec_name,channels,channel_layout -of default=nw=1 "$F" 2>&1 | head
    n=$(ffmpeg -v warning -f spdif -i "$F" -f null - 2>&1 | grep -c -i -E "error|invalid|sync|corrupt|missing")
    echo "-- decode warnings over $SECS s: $n  (0 = bit-exact and no slips; a few = occasional dropouts; many or no stream = not usable)"
    rm -f "$F"
    exit 0
fi

REPORT="$HOME/theater-preflight-$(date +%Y%m%d-%H%M%S).txt"
exec > >(tee "$REPORT") 2>&1
echo "theater preflight $(date -Is)"

sec "system"
grep -E "^(PRETTY_NAME|VERSION_ID)=" /etc/os-release
echo "kernel $(uname -r); session: ${XDG_SESSION_TYPE:-unknown}; desktop: ${XDG_CURRENT_DESKTOP:-unknown}"
have pipewire && pipewire --version | tail -1
have wireplumber && wireplumber --version | head -1
have mpv && mpv --version | head -1
have camilladsp && camilladsp --version
echo "cpu governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)"

sec "tools and python modules"
for t in pw-link pw-top pw-dump pw-cat pw-record wpctl pactl aplay arecord amixer camilladsp ffmpeg ffprobe mpv socat busctl eq theater-route; do
    have "$t" && ok "$t" || warn "$t missing"
done
python3 - <<'E' 2>&1
for m in ("numpy", "scipy", "yaml"):
    try:
        __import__(m); print("OK   ", "python", m)
    except ImportError:
        print("WARN  python", m, "missing (sudo apt install python3-" + ("yaml" if m == "yaml" else m) + ")")
E

sec "installed scripts match the repository"
SD="${SDHT:-$HOME/SDHT}"; [ -d "$SD/scripts" ] || SD="$HOME/sdht"
WS="${SDHT_WORKSPACE:-$(dirname "$SD")}"      # the project's repositories are cloned side by side (scripts/clone-all.sh)
CI="$(dirname "$(readlink -f "$0")")/check-installed.sh"
if [ -d "$WS/theater-router" ] || [ -d "$WS/mpv-object-audio" ]; then
    SDHT_WORKSPACE="$WS" bash "$CI" 2>&1 | sed -n '/^[a-z]/{/^repository state/q;p}' | while IFS= read -r l; do
        case "$l" in *identical*) ok "${l%% *} identical to the repo";; *DIFFERS*|*MISSING*|*NO-REPO*) warn "$l";; esac
    done
else
    warn "sibling repositories not found next to $SD (run scripts/clone-all.sh, or set SDHT_WORKSPACE)"
fi

sec "mpv-object-audio (Omniphony player stack)"
OA="${OA_HOME:-$HOME/.local/opt/mpv-object-audio}"
if [ -x "$OA/bin/mpv" ]; then
    ok "installed in $OA"
    [ -f "$OA/VERSIONS" ] && sed 's/^/      /' "$OA/VERSIONS"
    for f in "$OA/bin/mpv" "$OA/lib/liborender.so.0" "$OA/lib/libharletty_dolby_bridge.so" "$OA/lib/libharletty_dts_bridge.so" "$OA/lib/libharletty_iamf_bridge.so"; do
        [ -e "$f" ] && ok "$(basename "$f")" || warn "$f missing"
    done
    have mpv-object-audio && { mpv-object-audio --oa-check 2>&1 | head -4; } || warn "mpv-object-audio is not on PATH (~/.local/bin)"
    [ -f "$HOME/.config/mpv-object-audio/mpv.conf" ] && ok "own mpv config folder ~/.config/mpv-object-audio" || warn "no ~/.config/mpv-object-audio"
else
    warn "mpv-object-audio not installed (scripts/object-audio-install.sh)"
fi
if [ -f "$HOME/.local/bin/theater-route" ]; then
    grep -q "def cmd_prepare" "$HOME/.local/bin/theater-route" && ok "installed router knows 'eq prepare' (profile chosen before playback)" \
        || warn "installed router is older than the repository's (no 'eq prepare'): re-run install-autoroute.sh"
fi
echo "-- the engine's shared config (both players read it): $HOME/.config/omniphony/config.yaml"
[ -f "$HOME/.config/omniphony/config.yaml" ] && { stat -c '   %y  %s bytes' "$HOME/.config/omniphony/config.yaml"; grep -E "bridge_path|osc:|layout" "$HOME/.config/omniphony/config.yaml" | head -6 | sed 's/^/   /'; } || echo "   (none: engine defaults apply)"
echo "-- run 'preflight playing' in a second terminal while a film plays, and 'preflight compare FILE' to diff the two players"

sec "mpv scripts and the library (for the seek-thumbnail viewer)"
for d in "$HOME/.config/mpv" "$HOME/.config/mpv-object-audio"; do
    echo "-- $d"
    if [ -d "$d" ]; then
        echo "   scripts:"; ls -1 "$d/scripts" 2>/dev/null | sed 's/^/     /'
        echo "   script-opts:"; ls -1 "$d/script-opts" 2>/dev/null | sed 's/^/     /'
        for f in "$d"/scripts/uosc* "$d"/scripts/thumbfast*; do
            [ -e "$f" ] || continue
            v=$(grep -rhoiE "(version|VERSION)[ =:\"']+[0-9][0-9.]+" "$f" 2>/dev/null | head -1)
            echo "   $(basename "$f") ${v:+($v)}"
        done
        [ -f "$d/mpv.conf" ] && { echo "   mpv.conf:"; grep -v '^#' "$d/mpv.conf" | grep -v '^$' | sed 's/^/     /'; }
    else
        echo "   (no such folder)"
    fi
done
echo "-- rclone mount(s) (flags decide how many bytes one seek reads):"
ps -eo args 2>/dev/null | grep -E "[r]clone .*(mount|nfsmount|serve)" | sed 's/^/   /' | sed -E 's/(pass|password|token|secret)[= ][^ ]+/\1=***/Ig'
mount 2>/dev/null | grep -i rclone | sed 's/^/   /'
echo "-- seekthumbs:"
CFG="$HOME/.config/seekthumbs/config.ini"
if [ -f "$CFG" ]; then
    sed 's/^/   /' "$CFG"
    LIBP=$(awk -F'[=: ]+' '/^library/{print $2}' "$CFG"); STOREP=$(awk -F'[=: ]+' '/^store/{print $2}' "$CFG")
    LIBP="${LIBP/#\~/$HOME}"; STOREP="${STOREP/#\~/$HOME}"
    [ -n "$LIBP" ] && { [ -d "$LIBP" ] && ok "library folder exists: $LIBP" || warn "library folder not found: $LIBP"; }
    if [ -n "$STOREP" ] && [ -d "$STOREP" ]; then
        ok "store: $(du -sh "$STOREP" 2>/dev/null | cut -f1) in $(find "$STOREP" -name index.json 2>/dev/null | wc -l) entries"
        df -h "$STOREP" | tail -1 | sed 's/^/   /'
    fi
else
    warn "no $CFG yet (see docs/seekthumbs.md)"
fi
systemctl --user is-active seekthumbs.service 2>&1 | sed 's/^/   seekthumbs.service: /'
echo "-- seekthumbs.py status:"; [ -f "$WS/seekthumbs/seekthumbs.py" ] && python3 "$WS/seekthumbs/seekthumbs.py" status 2>&1 | head -8 | sed 's/^/   /'

sec "services"
for u in pipewire wireplumber pipewire-pulse theater-router theater-upmix; do echo "$u: $(systemctl --user is-active $u 2>&1)"; done
systemctl --user list-units --type=service --no-legend 2>/dev/null | grep -i camilla
echo "rtkit-daemon: $(systemctl is-active rtkit-daemon 2>&1); RLIMIT_RTPRIO: $(ulimit -r)"
N=15 run journalctl --user -u theater-upmix -n 15 --no-pager
N=10 run journalctl --user -u theater-router -n 10 --no-pager

sec "USB DAC (Vantec)"
if lsusb 2>/dev/null | grep -qi 0d8c; then ok "USB device 0d8c present"; lsusb | grep -i 0d8c; else warn "no USB device 0d8c: is the DAC connected?"; fi
pactl list short sinks 2>/dev/null | grep -q "$USB" && ok "sink $USB" || warn "sink $USB not found; usb sinks: $(pactl list short sinks 2>/dev/null | awk '{print $2}' | grep -i usb | tr '\n' ' ')"
echo "-- sources (a digital/IEC958 input would show here):"; pactl list short sources 2>/dev/null | grep -v monitor
echo "-- card profiles of the DAC:"
pactl list cards 2>/dev/null | awk '/^Card #/{c=0} /0d8c|USB Sound Device/{c=1} c' | grep -i -E "profiles:|iec958|surround|stereo|Active Profile" | head -25
card=$(grep -i "USB Sound Device" /proc/asound/cards 2>/dev/null | awk '{print $1}' | head -1)
if [ -n "$card" ]; then
    echo "-- ALSA card $card controls mentioning digital/capture:"
    amixer -c "$card" contents 2>/dev/null | grep -i -E "iec958|spdif|capture source|digital" | head
    arecord -l 2>/dev/null | grep -i -A1 "card $card"
fi

sec "audio outputs available (for the soundbar over HDMI)"
pactl list short sinks 2>/dev/null | awk '{print $2}'

sec "routing and the standing profile"
have eq && { N=40 run eq status; N=5 run eq source; } || warn "eq not installed"
echo "-- links involving the DSP, mpv, the engine and the DAC:"
pw-link -l 2>/dev/null | grep -i -E "camilla|mpv|theater|0d8c" | head -50
echo "-- Chrome nodes (for the stereo-app regex):"; pw-link -o 2>/dev/null | grep -i chrom | head -4

sec "graph health (xruns show as ERR)"
have pw-top && { T=8 N=30 run pw-top -b -n 2; } || warn "pw-top missing"

sec "display and mpv"
for s in /sys/class/drm/*/status; do [ -e "$s" ] && echo "$(basename "$(dirname "$s")"): $(cat "$s")"; done 2>/dev/null
if have mpv; then
    mpv --list-options 2>/dev/null | grep -E "^ --(hdr-compute-peak|hdr-peak|hdr-contrast|target-peak|target-contrast|tone-mapping|gamut)" | head -12
    S="${THEATER_MPV_SOCK:-${XDG_RUNTIME_DIR:-/tmp}/theater-mpv.sock}"
    if [ -S "$S" ] && have socat; then
        for p in hdr-compute-peak target-peak target-contrast hwdec vo; do
            echo -n "mpv $p = "; echo "{\"command\":[\"get_property\",\"options/$p\"]}" | socat - "$S" 2>/dev/null | head -1
        done
    else
        echo "(start a film with mpv-atmos and re-run to read the live mpv options)"
    fi
fi

if [ "$1" = "--tests" ]; then
    sec "repository tests"
    if [ -f "$SD/scripts/test-all.sh" ]; then
        out=$(bash "$SD/scripts/test-all.sh" 2>&1)
        echo "PASS lines: $(echo "$out" | grep -c '^PASS')"
        echo "$out" | grep -E "^FAIL|Traceback|^==|not found" | head -30
    else
        warn "scripts/test-all.sh not found"
    fi
fi
echo; echo "report saved to $REPORT"
